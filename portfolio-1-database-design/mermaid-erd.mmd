erDiagram
    ROOM_TYPES ||--o{ ROOMS : "categorises"
    GUESTS ||--o{ RESERVATIONS : "books"
    RESERVATIONS ||--|{ RESERVATION_ROOMS : "contains"
    ROOMS ||--o{ RESERVATION_ROOMS : "assigned_to"
    RESERVATIONS ||--o{ PAYMENTS : "settled_by"

    ROOM_TYPES {
        int room_type_id PK
        string type_name UK
        decimal base_rate
        int max_occupancy
        string bed_type
    }

    ROOMS {
        int room_id PK
        int room_type_id FK
        string room_number UK
        int floor_number
        string status
    }

    GUESTS {
        int guest_id PK
        string first_name
        string last_name
        string email UK
        string phone
        string identity_type
        string identity_number UK
        text residential_address
        string emergency_contact_name
        string emergency_contact_phone
        text emergency_contact_address
        timestamp created_at
    }

    RESERVATIONS {
        int reservation_id PK
        int guest_id FK
        date check_in_date
        date check_out_date
        string booking_status
        decimal total_amount
        timestamp created_at
    }

    RESERVATION_ROOMS {
        int reservation_room_id PK
        int reservation_id FK
        int room_id FK
        decimal nightly_rate
    }

    PAYMENTS {
        int payment_id PK
        int reservation_id FK
        timestamp payment_date
        decimal amount
        string payment_method
        string payment_status
        string transaction_reference UK
    }
